[Unit]
Description=Captura local do dia (áudio e telas)
# Sem `Wants=` fixo: quem entra aqui é o `WantedBy=` de cada captura, criado
# pelo `enable` e removido pelo `disable`. Com a dependência escrita no alvo,
# uma captura pausada voltava sozinha no boot — o alvo a puxava de qualquer
# jeito, habilitada ou não.
After=pipewire-pulse.service graphical-session.target

[Install]
WantedBy=default.target

