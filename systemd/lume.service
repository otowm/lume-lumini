[Unit]
Description=Lume - interface local da captura do dia
After=captura-dia.target
Wants=captura-dia.target

[Service]
Type=simple
WorkingDirectory=%h/Documentos/lume
ExecStart=%h/Documentos/lume/.venv/bin/python -m uvicorn app.backend.main:app --host 127.0.0.1 --port 8876
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
