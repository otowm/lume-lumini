[Unit]
Description=Lume - processa áudio, telas e resumo local
After=ollama.service captura-dia.target
Wants=captura-dia.target

[Service]
Type=oneshot
WorkingDirectory=@LUME_ROOT@
ExecStart=@LUME_PYTHON@ -m app.backend.pipeline --limit-audio 100 --limit-screen 250
Nice=10
IOSchedulingClass=idle
# O tamanho dos lotes não limita a fila; uma noite com backlog pode durar mais.
TimeoutStartSec=infinity
